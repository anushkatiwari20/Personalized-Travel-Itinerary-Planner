# ============ SUPABASE ============
# Project Settings -> Data API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings -> API Keys -> "Legacy anon, service_role API keys"
SUPABASE_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# ============ JWT AUTHENTICATION ============
# Generate a strong secret key (minimum 32 characters, use random string)
# You can use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============ AI MODEL CONFIGURATION ============
# Choose ONE: groq, huggingface, or ollama
# Groq is RECOMMENDED - Free tier with generous limits

# For Groq (RECOMMENDED)  -> https://console.groq.com/keys
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# For Hugging Face (free)  -> https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# For Ollama (Local - No API key needed)
# AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ============ SERVER CONFIGURATION ============
DEBUG=True
ENVIRONMENT=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ============ REDIS CONFIGURATION (Optional) ============
# For caching (optional, leave empty if not using)
REDIS_URL=

# ============ LOGGING ============
LOG_LEVEL=INFO
